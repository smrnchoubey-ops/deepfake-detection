# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///users.db

# Server
PORT=10000
HOST=0.0.0.0

# Model Settings
MAX_VIDEO_SIZE_MB=100
MAX_IMAGE_SIZE_MB=50
NUM_FRAMES_TO_EXTRACT=15

# Logging
LOG_LEVEL=INFO
